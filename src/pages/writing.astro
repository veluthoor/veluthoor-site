---
import Layout from '../layouts/Layout.astro';

const sections = [
  {
    title: 'Quarterly Reports',
    items: [
      { title: 'Personal Report: Q2 2023', slug: 'personal-report-q2-2023-2' },
      { title: 'Personal Report: Q3 2023', slug: 'personal-report-q3-2023' },
      { title: 'Personal Report: Q4 2023', slug: 'personal-report-q4-2023' },
    ],
  },
  {
    title: 'Annual Reports',
    items: [
{ title: '2023 Year End Review', slug: '2023-review' },
      { title: '2024 Year End Review', slug: '2024-year-end-review' },
      { title: '2025 Year End Review', slug: '2025-year-end-review' },
    ],
  },
  {
    title: 'Random Lists',
    items: [
      { title: 'Bucket List', slug: 'bucket-list' },
      { title: 'States & UT Checklist', slug: 'states-ut-checklist' },
      { title: 'Airlines List', slug: 'airlines-list' },
      { title: 'Things to Do in Bangalore', slug: 'list-of-things-to-do-in-bangalore' },
      { title: 'LDR Date Ideas', slug: 'list-of-ldr-date-ideas' },
      { title: 'Must Try Things in Kozhikode — Food', slug: 'must-try-things-in-kozhikode-food-editon' },
      { title: 'Asking People Above 50 for Advice', slug: 'asking-people-above-50-the-one-piece-of-advise-they-would-give-their-younger-self' },
    ],
  },
  {
    title: 'Other',
    items: [
      { title: 'What Makes for a Dream Job?', slug: 'what-makes-for-a-dream-job-2' },
      { title: 'Races & Results', slug: 'races-results' },
    ],
  },
];
---

<Layout title="Writing">
  <style>
    .writing-hero {
      text-align: center;
      padding: 3rem 0;
      margin-bottom: 3rem;
    }

    h1 {
      font-size: 4rem;
      font-weight: 900;
      letter-spacing: -0.03em;
      margin-bottom: 1rem;
    }

    .subtitle {
      font-size: 1.3rem;
      color: var(--muted);
      font-weight: 500;
      margin-bottom: 3rem;
    }

    .sections-container {
      max-width: var(--content-w);
      margin: 0 auto;
    }

    .section {
      margin-bottom: 4rem;
    }

    .section-title {
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 1.5rem;
      color: var(--primary);
    }

    .item-list {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.5rem;
    }

    .item {
      position: relative;
    }

    .item a {
      display: block;
      padding: 1.5rem;
      text-decoration: none;
      font-size: 1.05rem;
      font-weight: 700;
      background: white;
      border-radius: 24px;
      transition: all 0.2s ease;
      border: 5px solid var(--text);
      min-height: 80px;
      display: flex;
      align-items: center;
      box-shadow: 0 6px 0 rgba(0,0,0,0.2);
    }

    .item:nth-child(4n+1) a { border-color: var(--primary); }
    .item:nth-child(4n+2) a { border-color: var(--primary-dark); }
    .item:nth-child(4n+3) a { border-color: var(--primary-light); }
    .item:nth-child(4n+4) a { border-color: var(--accent); }

    .item a:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 0 rgba(0,0,0,0.2);
    }
  </style>

  <div class="writing-hero">
    <h1 class="gradient-text">Writing</h1>
    <p class="subtitle">Thoughts, reflections, and random musings</p>
  </div>

  <div class="sections-container">
    {sections.map(section => (
      <div class="section animate-on-scroll">
        <h2 class="section-title">{section.title}</h2>
        <ul class="item-list">
          {section.items.map(item => (
            <li class="item">
              <a href={`/pages/${item.slug}`}>{item.title}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Layout>
